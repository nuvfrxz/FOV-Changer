-- FOV Changer - Small Dark UI (Max 1000) + Persists after death/respawn
-- Place as LocalScript in StarterPlayer > StarterPlayerScripts

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local camera = workspace.CurrentCamera

local player = Players.LocalPlayer

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "FOVChanger"
screenGui.ResetOnSpawn = false
screenGui.Parent = player:WaitForChild("PlayerGui")

-- Small Main Frame
local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 260, 0, 145)
frame.Position = UDim2.new(0.5, -130, 0.42, 0)
frame.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true
frame.Parent = screenGui

-- Title Bar
local titleBar = Instance.new("Frame")
titleBar.Size = UDim2.new(1, 0, 0, 34)
titleBar.BackgroundColor3 = Color3.fromRGB(6, 6, 6)
titleBar.BorderSizePixel = 0
titleBar.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -75, 1, 0)
title.Position = UDim2.new(0, 12, 0, 0)
title.BackgroundTransparency = 1
title.Text = "FOV Changer"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextSize = 16
title.Font = Enum.Font.Gotham
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = titleBar

-- Close & Minimize Buttons
local closeBtn = Instance.new("TextButton")
closeBtn.Size = UDim2.new(0, 26, 0, 26)
closeBtn.Position = UDim2.new(1, -34, 0, 4)
closeBtn.BackgroundTransparency = 1
closeBtn.Text = "X"
closeBtn.TextColor3 = Color3.fromRGB(255, 70, 70)
closeBtn.TextSize = 20
closeBtn.Font = Enum.Font.Gotham
closeBtn.Parent = titleBar

local minBtn = Instance.new("TextButton")
minBtn.Size = UDim2.new(0, 26, 0, 26)
minBtn.Position = UDim2.new(1, -64, 0, 4)
minBtn.BackgroundTransparency = 1
minBtn.Text = "−"
minBtn.TextColor3 = Color3.fromRGB(170, 170, 170)
minBtn.TextSize = 24
minBtn.Font = Enum.Font.Gotham
minBtn.Parent = titleBar

-- Content
local content = Instance.new("Frame")
content.Size = UDim2.new(1, 0, 1, -34)
content.Position = UDim2.new(0, 0, 0, 34)
content.BackgroundTransparency = 1
content.Parent = frame

-- Input Box
local inputBox = Instance.new("TextBox")
inputBox.Size = UDim2.new(0.48, 0, 0, 38)
inputBox.Position = UDim2.new(0.06, 0, 0.35, 0)
inputBox.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
inputBox.PlaceholderText = "1-1000"
inputBox.Text = "70"
inputBox.TextColor3 = Color3.fromRGB(200, 200, 200)
inputBox.TextSize = 15
inputBox.Font = Enum.Font.Gotham
inputBox.ClearTextOnFocus = false
inputBox.BorderSizePixel = 0
inputBox.Parent = content

-- Apply Button
local applyBtn = Instance.new("TextButton")
applyBtn.Size = UDim2.new(0.38, 0, 0, 38)
applyBtn.Position = UDim2.new(0.57, 0, 0.35, 0)
applyBtn.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
applyBtn.Text = "apply"
applyBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
applyBtn.TextSize = 15
applyBtn.Font = Enum.Font.Gotham
applyBtn.BorderSizePixel = 0
applyBtn.Parent = content

-- Variables
local currentFOV = 70
local isMinimized = false
local fullSize = frame.Size

local function applyFOV()
    local num = tonumber(inputBox.Text)
    if num then
        currentFOV = math.clamp(math.floor(num), 1, 1000)
        camera.FieldOfView = currentFOV
        inputBox.Text = tostring(currentFOV)
    else
        inputBox.Text = tostring(currentFOV)
    end
end

-- Apply button & Enter key
applyBtn.MouseButton1Click:Connect(applyFOV)
inputBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        applyFOV()
    end
end)

-- Re-apply FOV every time the character respawns
player.CharacterAdded:Connect(function()
    -- Small delay to let the camera fully load
    task.wait(0.5)
    camera.FieldOfView = currentFOV
end)

-- Close / Minimize
closeBtn.MouseButton1Click:Connect(function()
    screenGui.Enabled = false
end)

minBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        content.Visible = false
        frame.Size = UDim2.new(0, 260, 0, 34)
        minBtn.Text = "+"
    else
        content.Visible = true
        frame.Size = fullSize
        minBtn.Text = "−"
    end
end)

-- Toggle UI with F key
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.F then
        screenGui.Enabled = not screenGui.Enabled
        if screenGui.Enabled and isMinimized then
            isMinimized = false
            content.Visible = true
            frame.Size = fullSize
            minBtn.Text = "−"
        end
    end
end)

-- Initial apply
task.wait(1)  -- Give time for camera to initialize
camera.FieldOfView = currentFOV
inputBox.Text = tostring(currentFOV)

print("FOV Changer loaded! (Persists after death) • Max 1000 • Press F to toggle")
